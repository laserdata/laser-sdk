{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laserdata.com/schemas/benchmark/suite-v1.schema.json",
  "title": "Laser benchmark suite manifest",
  "type": "object",
  "required": ["schema_version", "name", "authoritative", "provisioning", "environment", "scenarios"],
  "properties": {
    "schema_version": { "const": 1 },
    "name": { "type": "string", "minLength": 1 },
    "authoritative": { "type": "boolean" },
    "provisioning": {
      "type": "object",
      "required": ["mode", "cpu_target"],
      "properties": {
        "mode": { "enum": ["source", "path", "artifact", "compose"] },
        "cpu_target": { "type": "string", "minLength": 1 },
        "iggy_server_version": { "type": ["string", "null"], "minLength": 1 },
        "iggy_bench_version": { "type": ["string", "null"], "minLength": 1 },
        "plane_version": { "type": ["string", "null"], "minLength": 1 }
      },
      "additionalProperties": true
    },
    "environment": {
      "type": "object",
      "required": ["tier", "durability_profile", "cache_state"],
      "properties": {
        "plane_profile": { "enum": ["embedded", "postgres"] },
        "postgres_dsn_env": { "type": "string", "minLength": 1 },
        "postgres_ssl_mode": { "type": "string", "minLength": 1 },
        "postgres_pool_connections": { "type": "integer", "minimum": 1 },
        "postgres_schema": { "type": "string", "minLength": 1 },
        "postgres_timeout": { "type": "string", "minLength": 1 },
        "postgres_pid_env": { "type": "string", "minLength": 1 },
        "host": {
          "type": "object",
          "required": ["client_cpus", "iggy_cpus", "numa_node", "clocksource", "governor", "smt_enabled", "turbo_enabled", "filesystem", "disk_model", "perf_counters", "max_steal_ticks"],
          "properties": {
            "client_cpus": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 0 }, "uniqueItems": true },
            "iggy_cpus": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 0 }, "uniqueItems": true },
            "plane_cpus": { "type": "array", "items": { "type": "integer", "minimum": 0 }, "uniqueItems": true },
            "numa_node": { "type": "integer", "minimum": 0 },
            "clocksource": { "type": "string", "minLength": 1 },
            "governor": { "type": "string", "minLength": 1 },
            "smt_enabled": { "type": "boolean" },
            "turbo_enabled": { "type": "boolean" },
            "filesystem": { "type": "string", "minLength": 1 },
            "disk_model": { "type": "string", "minLength": 1 },
            "perf_counters": { "type": "boolean" },
            "max_steal_ticks": { "type": "integer", "minimum": 0 },
            "max_temperature_millidegrees_celsius": { "type": "integer" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "layer", "arm", "driver", "transport", "repetitions", "warmup_seconds", "duration_seconds", "payload_bytes", "batch_size", "partitions", "producers", "consumers", "operations"],
        "properties": {
          "layer": { "enum": ["L1", "L2", "L3", "L4", "L5", "L6", "L7"] },
          "transport": { "const": "tcp_vsr" },
          "corpus_entries": { "type": ["integer", "null"], "minimum": 1 },
          "vector_dimensions": { "type": ["integer", "null"], "minimum": 1 },
          "spin_dispatch": { "type": "boolean" },
          "timeout_millis": { "type": ["integer", "null"], "minimum": 1 },
          "max_in_flight": { "type": ["integer", "null"], "minimum": 1 }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
